<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="afernandezS5A.Views.vPersona"
             Title="vPersona">

    <VerticalStackLayout Padding="15"
                         Spacing="15">

        <Label Text="Semana 5: BASE DE DATOS LOCALES"
               FontSize="20"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <Entry x:Name="txtName"
               Placeholder="Ingresa el Nombre" />

        <Grid RowSpacing="5"
              ColumnSpacing="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAgregar"
                    Text="Agregar Persona"
                    Clicked="btnAgregar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0" />

            <Label x:Name="lblStatusMessage"
                   TextColor="Red"
                   Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2" />

            <Button x:Name="btnMostar"
                    Text="Mostrar Personas"
                    Clicked="btnMostar_Clicked"
                    Grid.Row="2"
                    Grid.Column="0" />

            <CollectionView x:Name="listaPersonas"
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Grid Padding="5" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Text="{Binding Id}"
                                   Grid.Column="0"
                                   VerticalOptions="Center" />

                            <Label Text="{Binding Name}"
                                   Grid.Column="1"
                                   VerticalOptions="Center" />

                            <Button Text="Eliminar"
                                    Clicked="btnEliminar_Clicked"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    Grid.Column="2" />

                            <Button Text="Actualizar"
                                    Clicked="btnActualizar_Clicked"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="Orange"
                                    TextColor="White"
                                    Grid.Column="3" />
                        </Grid>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </VerticalStackLayout>
</ContentPage>